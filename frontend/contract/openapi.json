    "/health": {
      "get": {
        "description": "Readiness probe: 200 only when the app can actually serve requests.\n\nRequires (1) a working DB connection whose ``alembic_version`` is the\nAlembic head revision (``SELECT 1`` plus that check, bounded by\n``READINESS_DB_TIMEOUT_SECONDS``; HARDENING_PLAN.md finding P2-M2), (2) every SV2TTS model loaded on the\nconfigured device, and (3) when ``READINESS_WARMUP_ENABLED`` is set, a\nsuccessful startup warm-up forward pass. ``/health`` is kept as an alias\nfor backward compatibility. Errors are logged, never returned.",
        "operationId": "readiness_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    },
    "/health/live": {
      "get": {
        "description": "Liveness probe: the process is up and serving. Checks no dependencies.\n\nDeliberately never touches the DB or models, so an orchestrator only\nrestarts the container when the process itself is wedged \u2014 not during a\nDB outage or model problem (HARDENING_PLAN.md finding M7).",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Liveness Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness"
      }
    },
