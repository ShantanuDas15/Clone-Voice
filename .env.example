# Variables read by docker-compose.yml itself (Docker Compose auto-loads a
# `.env` file from this directory for `${VAR}` substitution in the compose
# file — distinct from backend/.env, which is injected into the `backend`
# container's own process environment via `env_file:`).
#
# Copy this to `.env` in this same directory to override the defaults below;
# .env is gitignored like backend/.env. The defaults match the previous
# hardcoded values, so `docker compose up` still works with no `.env` here —
# override POSTGRES_PASSWORD (at minimum) for anything beyond local dev
# (HARDENING_PLAN.md finding L12).
POSTGRES_USER=clonevoice
POSTGRES_PASSWORD=clonevoice_dev
POSTGRES_DB=clonevoice
# Host port the db service's 5432 is published on, bound to 127.0.0.1 only —
# not reachable from outside the host regardless of this value.
POSTGRES_PORT=5432
# Host address the backend's port 8000 is published on. Default 127.0.0.1 keeps
# the API (and /metrics) off other machines; front it with a reverse proxy on
# this host, or set 0.0.0.0 deliberately (HARDENING_PLAN.md finding P2-L6).
# BACKEND_BIND_ADDRESS=127.0.0.1
