{
  "name": "clonevoice-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts --project=chromium",
    "test:cross-browser": "playwright test -c playwright.visual.config.ts --project=webkit --project=firefox",
    "perf": "node perf/run.mjs",
    "smoke": "node smoke/run.mts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/browser": "^8.55.2",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^25.0.1",
    "lighthouse": "^13.5.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "tldts": "^7.4.18",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
