# Must end with /api/v1; the API must be same-site with the web app (refresh cookie).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Server-side only (not NEXT_PUBLIC): set to 1 to ENFORCE the Content-Security-Policy.
# Unset = report-only (browser console reports violations, nothing is blocked). Soak first.
# CSP_ENFORCE=1
