# Database
DATABASE_URL=postgresql://clonevoice:clonevoice_dev@localhost:5432/clonevoice
# Connection pool sizing and connect timeout (finding L5). Postgres-only —
# ignored for a SQLite DATABASE_URL (e.g. in tests).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS=10

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Session cookie secret (authlib's OAuth login flow, finding L6). Must differ
# from JWT_SECRET_KEY; falls back to it with a warning when left blank.
SESSION_SECRET_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Rate limiting (HARDENING_PLAN.md M3). Use a shared store in production.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
# Number of trusted reverse proxies in front of the API (0 = none; X-Forwarded-For ignored).
# TRUSTED_PROXY_COUNT=0
# AUTH_LOGIN_RATE_LIMIT=10/minute
# AUTH_SIGNUP_RATE_LIMIT=5/minute

# App
APP_ENV=development
DEVICE=cpu
MAX_AUDIO_SIZE_MB=25
# Multipart overhead allowed above MAX_AUDIO_SIZE_MB (body limit, finding M5)
# REQUEST_BODY_OVERHEAD_KB=256
# Voice-sample duration bounds (seconds): minimum is measured after silence trimming.
# MIN_VOICED_DURATION_SECONDS=2.0
# MAX_AUDIO_DURATION_SECONDS=300.0
# Relative paths are anchored to backend/ (not the launch directory); absolute paths are used as-is.
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
# Directory containing TorchScript model checkpoints (synthesizer.pt, vocoder.pt).
# Defaults to backend/weights when unset — uncomment to override.
# WEIGHTS_DIR=/absolute/path/to/weights

# Exception tracking (Sentry) — leave SENTRY_DSN blank to disable
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Max seconds to wait for in-flight inference on shutdown (finding M6)
# INFERENCE_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30
# Sentence chunking for synthesis (max chars per decode, pause between chunks)
# TTS_CHUNK_MAX_CHARS=150
# TTS_CHUNK_PAUSE_SECONDS=0.15
# Days a synthesized WAV is protected from cleanup (0 = keep forever)
# OUTPUT_RETENTION_DAYS=30
# Readiness probe (finding M7): DB check timeout and optional startup warm-up pass
# READINESS_DB_TIMEOUT_SECONDS=2
# READINESS_WARMUP_ENABLED=false
# Prometheus /metrics endpoint (finding M8); set a token to require a bearer header
# METRICS_ENABLED=true
# METRICS_AUTH_TOKEN=
