# Database
DATABASE_URL=postgresql://clonevoice:clonevoice_dev@localhost:5432/clonevoice
# Connection pool sizing and connect timeout (finding L5). Postgres-only —
# ignored for a SQLite DATABASE_URL (e.g. in tests).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS=10

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# A rotated refresh token replayed within this many seconds is refused without
# revoking the whole session family (two tabs refreshing at once). 0 = strict.
# REFRESH_REUSE_GRACE_SECONDS=10
# Rows of refresh tokens expired more than this many days ago are deleted hourly.
# REFRESH_TOKEN_PRUNE_AFTER_DAYS=1
# Session cookie secret (authlib's OAuth login flow, finding L6). Must differ
# from JWT_SECRET_KEY; falls back to it with a warning when left blank.
SESSION_SECRET_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Rate limiting (HARDENING_PLAN.md M3). Use a shared store in production.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
# Number of trusted reverse proxies in front of the API (0 = none; X-Forwarded-For ignored).
# TRUSTED_PROXY_COUNT=0
# AUTH_LOGIN_RATE_LIMIT=10/minute
# AUTH_SIGNUP_RATE_LIMIT=5/minute
# Limits for the endpoints that send email (resend-verification, forgot-password)
# and for the ones that consume an emailed token (verify-email, reset-password).
# AUTH_EMAIL_RATE_LIMIT=5/hour
# AUTH_TOKEN_RATE_LIMIT=20/minute

# Email verification and password reset (HARDENING_PLAN.md P2-H1).
# With verification required (default), a local account that has not verified
# its address can sign in but cannot upload a voice or synthesize. Google
# accounts are verified automatically. To develop without a mail provider,
# either set REQUIRE_EMAIL_VERIFICATION=false, or EMAIL_BACKEND=console (logs
# each message, link included: development only, never in production).
REQUIRE_EMAIL_VERIFICATION=true
# EMAIL_VERIFICATION_EXPIRE_HOURS=24
# PASSWORD_RESET_EXPIRE_MINUTES=30
# Base URL of the web app: emailed links open {FRONTEND_URL}/verify-email?token=...
FRONTEND_URL=http://localhost:3000
# disabled (sends nothing, the default) | console | resend | smtp
EMAIL_BACKEND=disabled
# "Name <address@your-domain>"; required for every backend except disabled. The
# domain must be verified with the provider (SPF/DKIM) or mail lands in spam.
EMAIL_FROM=
# resend: HTTPS API, works on hosts that block outbound SMTP (e.g. Railway).
RESEND_API_KEY=
# smtp: an SMTP relay (STARTTLS on by default).
SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# App
# HARDENING_PLAN.md finding P2-L7: ships as "production" (INFO logging) so a
# deployment that copies this file unedited doesn't run DEBUG logs, which
# include per-request user ids and file paths. Set to "development" for
# verbose logging during local development.
APP_ENV=production
DEVICE=cpu
# Torch CPU threads. 0 (default) follows the container CPU limit (docker --cpus,
# Kubernetes limits) when it is tighter than the host's cores; an explicit
# OMP_NUM_THREADS is respected. Set a number to force it.
# TORCH_NUM_THREADS=0
MAX_AUDIO_SIZE_MB=25
# Multipart overhead allowed above MAX_AUDIO_SIZE_MB (body limit, finding M5)
# REQUEST_BODY_OVERHEAD_KB=256
# Voice-sample duration bounds (seconds): minimum is measured after silence trimming.
# MIN_VOICED_DURATION_SECONDS=2.0
# MAX_AUDIO_DURATION_SECONDS=300.0
# Relative paths are anchored to backend/ (not the launch directory); absolute paths are used as-is.
# (these are the defaults; leave them commented out if you set DATA_DIR below, since an
# explicit value always beats DATA_DIR)
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs
# Directory containing TorchScript model checkpoints (synthesizer.pt, vocoder.pt).
# Defaults to backend/weights when unset — uncomment to override.
# WEIGHTS_DIR=/absolute/path/to/weights
# One absolute directory holding uploads/, outputs/ and weights/ (for a host with a
# single persistent volume, e.g. Railway: DATA_DIR=/data). Any of the three set
# above still wins. See RAILWAY_DEPLOYMENT.md.
# DATA_DIR=/data
# Download missing or corrupt checkpoints (checksum-verified) when the container
# starts. Off by default: provisioning is otherwise an explicit operator step.
# FETCH_WEIGHTS_ON_START=false

# Exception tracking (Sentry) — leave SENTRY_DSN blank to disable
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Max seconds for EACH inference stage (encoder / synthesizer / vocoder), not the
# whole call: a synthesis may take up to twice this (finding P2-L3)
# INFERENCE_CALL_TIMEOUT_SECONDS=30
# Max seconds to wait for in-flight inference on shutdown (finding M6). Keep
# docker-compose stop_grace_period >= uvicorn --timeout-graceful-shutdown (30) + this + margin (P2-L4)
# INFERENCE_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30
# Sentence chunking for synthesis (max chars per decode, pause between chunks)
# TTS_CHUNK_MAX_CHARS=150
# TTS_CHUNK_PAUSE_SECONDS=0.15
# Days a synthesized WAV is protected from cleanup (0 = keep forever)
# OUTPUT_RETENTION_DAYS=30
# Version of the acceptable-use terms a voice upload attests to; stored on every
# voice profile beside its consent timestamp. Bump when the terms text changes.
# TERMS_VERSION=2026-09-30
# Readiness probe (finding M7): DB check timeout and optional startup warm-up pass
# READINESS_DB_TIMEOUT_SECONDS=2
# READINESS_WARMUP_ENABLED=false
# Prometheus /metrics endpoint (finding M8); set a token to require a bearer header.
# Outside APP_ENV=development an empty token makes /metrics return 401 (P2-L6).
# METRICS_ENABLED=true
# METRICS_AUTH_TOKEN=
